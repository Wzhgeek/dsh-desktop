    "@deepseek-ai/dsh-session-projection": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-session-reference": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-session-telemetry": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-title-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-shell": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-skill": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-skill-filesystem": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-spill": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-subagent-in-process-driver": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-terminal": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-terminal-bash": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-time-context": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-timeout": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tmux-context": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-token-meter": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tool-ask-user": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tool-bash": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tool-bash-persistent": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tool-cordis": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tool-fs": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tool-fs-search": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tool-goal": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tool-jobs": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tool-pwsh": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tool-ralph": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tool-skill": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tool-str-replace-editor": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tool-subagent": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tool-subagent-control": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tool-todo": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tool-web": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tool-workflow": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-web-app": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-workflow": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-workflow-worker-thread": "^0.1.0-rc.5",
    "@dsh-desktop/client": "link:plugins/client",
    "commander": "^15.0.0",
    "electron-updater": "6.8.9",
    "js-yaml": "^4.2.0",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "electron": "^37.0.0",
    "electron-builder": "26.15.3",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@deepseek-ai/dsh-subprocess-local",
      "electron",
      "esbuild",
      "koffi",
      "node-pty"
    ]
  },
  "build": {
    "appId": "com.wzhgeek.dshdesktop",
    "productName": "Dsh Desktop",
    "asar": false,
    "asarUnpack": [
      "**/*.node"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "plugins/client/lib/**/*",
      "plugins/client/package.json",
      "resources/**/*",
      "package.json"
    ],
    "artifactName": "Dsh-Desktop-${version}-${os}-${arch}.${ext}",
    "generateUpdatesFilesForAllChannels": true,
    "publish": [
      {
        "provider": "github",
        "owner": "Wzhgeek",
        "repo": "dsh-desktop",
        "releaseType": "prerelease",
        "channel": "latest"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/dsh-icon.icns",
      "hardenedRuntime": true,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "resources/dsh-icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "icon": "resources/dsh-icon.png",
      "category": "Development",
      "executableName": "dsh-desktop",
      "maintainer": "Wzhgeek <wangzh011031@163.com>",
      "synopsis": "DeepSeek Harness desktop client",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
