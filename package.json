{
  "name": "@deepseek-ai/dsh-desktop",
  "productName": "Dsh Desktop",
  "desktopName": "Dsh Desktop.desktop",
  "description": "The DeepSeek Harness GUI as a native Electron desktop app",
  "author": "Wzhgeek",
  "version": "0.1.0-rc.11",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "files": [
    "dist",
    "resources"
  ],
  "scripts": {
    "build": "pnpm --dir plugins/client run build && tsc -p tsconfig.json",
    "start": "electron .",
    "dev": "pnpm build && electron .",
    "build:client": "pnpm --dir plugins/client run build",
    "test": "node --import tsx --test \"src/*.test.ts\" \"src/host/*.test.ts\" \"tests/*.test.ts\"",
    "smoke": "tsx src/smoke.ts",
    "render-smoke": "pnpm build && electron dist/render-smoke.js",
    "runtime-smoke": "pnpm build && electron dist/desktop-runtime-smoke.js",
    "pack:dir": "pnpm build && electron-builder --dir",
    "dist:mac": "pnpm build && electron-builder --mac --x64 --arm64 --publish never",
    "dist:win": "pnpm build && electron-builder --win --x64 --publish never",
    "dist:linux": "pnpm build && electron-builder --linux --x64 --publish never"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-group": "^1.0.1",
    "@deepseek-ai/cordis-plugin-hmr": "^1.0.16",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/cordis-plugin-timer": "^1.1.3",
    "@deepseek-ai/dsh": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-instructions": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-agent-tool-presentation": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-anonymous-user-id": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-app-boot": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-atomic-write": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-base": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-bash-local": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-agent-preset": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-cordis": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-cmdline": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-code-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-command-compact": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-command-goal": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-compaction": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-compaction-basic": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-cordis-client-runner": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-fs": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-fs-local": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-goal": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-goal-round-driver": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-headless": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-host-directory-picker": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-jobs-local": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-launch-environment": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-mcp-client": "^0.1.0-rc.5",
